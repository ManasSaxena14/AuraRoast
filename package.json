{
  "name": "aura-toast",
  "version": "2.0.0",
  "private": true,
  "description": "AURA TOAST \u2014 Atmospheric Craft, Pure Origin",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run motion:lint",
    "motion:lint": "node scripts/check-easing.mjs",
    "test": "AURA_EPHEMERAL=1 node --test --experimental-strip-types --import ./tests/hooks.mjs 'tests/unit/*.test.ts'",
    "test:concurrency": "AURA_EPHEMERAL=1 node --test --experimental-strip-types --import ./tests/hooks.mjs 'tests/concurrency/*.test.ts'",
    "test:all": "npm run test && npm run test:concurrency && npm run motion:lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx drizzle/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "next": "16.3.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}