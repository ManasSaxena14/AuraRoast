# ─────────────────────────────────────────────────────────────────────────
# AURA TOAST — environment
#
# EVERY value here is optional. `npm run dev` with no .env.local at all gives
# you the whole product: catalogue, ordering, tracking, reservations, loyalty,
# admin, and the Barista. Each variable below upgrades one surface in place.
#
# Never commit .env.local. Never paste a real credential into a chat or a
# README — if one has been, rotate it before doing anything else.
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PostgreSQL (Neon) ────────────────────────────────────────────────────
# Present  → the Drizzle/Neon path in src/repositories
# Absent   → the in-process adapter, which implements the same operations
#            with the same atomicity guarantees (see the README)
# The app uses the POOLED endpoint; migrations use the DIRECT one.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/aura_toast?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/aura_toast?sslmode=require

# ── Auth.js v5 · Google is the only sign-in ──────────────────────────────
# Guest checkout works without any of this.
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ── AI Barista (Groq free tier) ──────────────────────────────────────────
# Without a key the tools still run for real against the live catalogue —
# only the language generation falls back to a local responder.
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Payments ─────────────────────────────────────────────────────────────
# These are CONFIGURATION, not secrets. A UPI ID exists to be shared in order
# to receive money, exactly like an account number printed on an invoice.
UPI_ID=auratoast@upi
UPI_PAYEE_NAME=Aura Toast Coffee

# ── Cron ─────────────────────────────────────────────────────────────────
# Protects POST /api/cron/cleanup, which sweeps expired idempotency and
# rate-limit rows. Postgres has no TTL indexes.
# CRON_SECRET=
