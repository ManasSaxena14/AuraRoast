# ─────────────────────────────────────────────────────────────────────────
# AURA TOAST — environment
#
# EVERY value here is optional. `npm run dev` with no .env.local at all gives
# you the whole product: catalogue, ordering, tracking, reservations, loyalty,
# admin, and the Barista. Each variable below upgrades one surface in place.
#
# Never commit .env.local. Never paste a real credential into a chat or a
# README — if one has been, rotate it before doing anything else.
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Present  → Postgres is the ONLY source of truth for orders, reservations,
#            reviews, accounts, loyalty and subscriptions (src/repositories/pg.ts)
# Absent   → the in-process adapter, which implements the same operations
#            with the same atomicity guarantees (local development only — its
#            memory is not shared between serverless instances)
# A Neon URL (*.neon.tech) uses Neon's HTTP driver; any other Postgres uses
# node-postgres, so a local `postgres://localhost/aura` works too.
# The app uses the POOLED endpoint; migrations use the DIRECT one.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/aura_toast?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/aura_toast?sslmode=require
#
# After `npm run db:migrate && npm run db:seed`, reservation slots are written
# by the app itself the first time each day is viewed — there is no cron.

# ── Auth.js v5 · Google is the only sign-in ──────────────────────────────
# Guest checkout works without any of this. All THREE are required for the
# "Continue with Google" button to be enabled.
# In Google Cloud Console → Credentials → your OAuth client, add the redirect
# URI  https://YOUR-DOMAIN/api/auth/callback/google  (and the localhost one
# for development: http://localhost:3000/api/auth/callback/google).
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ── Back office ──────────────────────────────────────────────────────────
# Comma-separated Google account emails allowed into /admin (to verify UPI
# payments and see every order). Unset → /admin is locked for everyone in
# production. Without Google credentials, `npm run dev` opens it in demo mode.
# ADMIN_EMAILS=you@example.com,manager@example.com
# Optional: lets scripts call PATCH /api/admin/orders/:n/verify-payment with
# `Authorization: Bearer $ADMIN_SECRET` instead of a signed-in session.
# ADMIN_SECRET=

# ── AI Barista (Groq free tier) ──────────────────────────────────────────
# Without a key the tools still run for real against the live catalogue —
# only the language generation falls back to a local responder.
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Payments ─────────────────────────────────────────────────────────────
# These are CONFIGURATION, not secrets. A UPI ID exists to be shared in order
# to receive money, exactly like an account number printed on an invoice.
UPI_ID=auratoast@upi
UPI_PAYEE_NAME=Aura Toast Coffee

# ── Cron (optional) ──────────────────────────────────────────────────────
# Expired idempotency and rate-limit rows are swept automatically as requests
# come in. /api/cron/cleanup (GET for Vercel Cron, or POST) runs the same
# sweep on demand, protected by this secret. Unset → the route refuses.
# CRON_SECRET=
